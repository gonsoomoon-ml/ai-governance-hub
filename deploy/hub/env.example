# Copy to deploy/hub/.env (git-ignored). Real values stay off the public repo.
AWS_PROFILE=CHANGE_ME
AWS_REGION=us-west-2
EKS_CLUSTER=llm-gateway-dev            # cluster whose OIDC provider the IRSA role trusts
NAMESPACE=llm-gateway                  # namespace of the Helm release
SERVICE_ACCOUNT=governance-hub         # serviceAccount.name in deploy/helm/governance-hub/values.yaml
TABLE=ai-governance-hub                # DDB_TABLE
ROLE_NAME=ai-governance-hub-role
# Optional, from deploy/agentcore/.env — scopes the role to the demo registry/gateway. Empty = no AgentCore access.
REGISTRY_ARN=
GATEWAY_ID=
GATEWAY_ROLE_ARN=
# 20-cognito-callback.sh — the hub's https host; its callback https://<HUB_HOST>/auth/callback is added to the
# gateway's Cognito app client through terraform.tfvars (GATEWAY_TF_DIR defaults to the gateway clone's
# deployment/terraform/environments/llm-gateway-<DEPLOY_ENV>).
HUB_HOST=hub-dev.CHANGE_ME
GATEWAY_TF_DIR=
