# Copy to deploy/agentcore/.env (git-ignored). Real values stay off the public repo.
AWS_PROFILE=CHANGE_ME
AWS_REGION=us-west-2
DEMO_PREFIX=ai-governance-demo
COGNITO_USER_POOL_ID=CHANGE_ME            # existing dev pool (Hosted UI domain must exist)
COGNITO_DOMAIN=CHANGE_ME                  # Hosted UI domain prefix
CLAUDE_CODE_MCP_CALLBACK_PORT=8094        # Claude Code managedMcpServers.oauth.callbackPort
RUNTIME_PLATFORM_VERSION=V2               # V1 | V2 (snapshot start); set at CreateAgentRuntime by deploy_runtime.py
RUNTIME_ARTIFACT=container                # container (Dockerfile -> ECR, portable) | zip (direct code deployment)
